# ==============================================================================
# FASTAPI BACKEND CONFIGURATION (.env)
# ==============================================================================

# Server Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME="Library Access Control System"
API_V1_STR=/api/v1

# Security API Key for Hardware Devices (ESP32)
# The ESP32 must provide this in the "X-API-KEY" HTTP header
DEVICE_API_KEY=lib_esp32_secret_key_prod_998877

# Database Connection (Supabase / PostgreSQL)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# For Supabase Session/Transaction pooler (port 5432 or 6543)
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_db_password@db.your-supabase-project.supabase.co:5432/postgres

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-domain.com

# Google Sheets Integration (วิธีที่ 1: Google Apps Script Webhook - แนะนำ ง่ายที่สุด!)
# นำ URL จาก Google Apps Script (Web App) มาวางที่นี่
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx_YOUR_SCRIPT_ID/exec

# Google Sheets Integration (วิธีที่ 2: Google Cloud Service Account - ทางเลือกสำรอง)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_ACCESS_LOGS_TAB=Access_Logs
SHEET_DAILY_SUMMARY_TAB=Daily_Summary

# Automated Sync Schedule (Cron format)
# Default runs every day at 23:59 Asia/Bangkok
CRON_TIMEZONE=Asia/Bangkok
