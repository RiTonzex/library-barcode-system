# ==============================================================================
# GITIGNORE - INDUSTRY STANDARD (FULL-STACK & IOT REPO)
# ==============================================================================

# Environment & Sensitive Credentials (DO NOT COMMIT SECRETS!)
.env
.env.local
.env.*.local
service_account.json
*.pem
*.key

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
*.db
backend/app/data/

# Node.js & Frontend Build Outputs
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ESP32 / PlatformIO Build Artifacts
.pio/
.pioenvs/
.piolibdeps/

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
